{
    // Formatting mirrors pera-react-native. `sortImports` additionally
    // enforces its documented import order (see CLAUDE.md).
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "avoid",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "endOfLine": "lf",
    "jsxSingleQuote": true,
    "printWidth": 80,
    "quoteProps": "as-needed",
    "semi": false,
    "singleAttributePerLine": true,
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "all",
    "sortImports": {
        "internalPattern": [
            "@app/",
            "@components/",
            "@lib/",
            "@modules/",
            "@scenarios/",
            "@test-utils/"
        ],
        "customGroups": [
            { "groupName": "react", "elementNamePattern": ["react", "react-dom", "react-dom/**"] },
            { "groupName": "perawallet", "elementNamePattern": ["@perawallet/**"] }
        ],
        "groups": [
            "side_effect",
            "react",
            ["builtin", "external"],
            "perawallet",
            "internal",
            ["parent", "sibling", "index"],
            "unknown"
        ]
    },
    "ignorePatterns": ["build/**", "coverage/**"]
}
